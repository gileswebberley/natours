extends base
//- get our show/hide password field mixin
include _passwordInput

block append head
    script(src='/js/passwordInputToggler.js')
    script(type='module' src='/js/login.js' defer)
    script(type='module' src='/js/forgotPassword.js' defer)

block content
    main.main
        .login-form
            h2.heading-secondary.ma-bt-lg Log into your account
            form.form
                .form__group
                    label.form__label(for='email') Email address
                    input#email.form__input(type='email', placeholder='you@example.com', required, autocomplete='email', autofocus)
                .form__group.ma-bt-md
                    +passwordInput('password', 'password', 'Password')(class='form__input ma-bt-md' placeholder='••••••••' autocomplete='current-password' minlength='8')
                .form__buttons
                    button.btn.btn--green.ma-bt-md(type='submit') Login
                    button#forgot-pword.btn.btn--small(type='button') Forgot Password
            //- .form__group