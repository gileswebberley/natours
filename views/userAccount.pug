extends base
include _userMenuItem

block content

    main.main
        .user-view
            nav.user-view__menu
                //- hamburger menu for smaller screens
                input#nav-toggle.nav-toggle-checkbox(type="checkbox")
                label.nav-toggle-button(for="nav-toggle")
                    span.nav-toggle-icon &nbsp;
                .user-view__menu-container
                    ul.side-nav
                        +userMenuItem('/me', 'settings', 'Settings', currentPath === '/me')
                        +userMenuItem('/my-tours', 'briefcase', 'My Bookings', currentPath === '/my-tours')
                        +userMenuItem('/my-reviews', 'star', 'My Reviews', currentPath === '/my-reviews')
                        //- +userMenuItem('#', 'credit-card', 'Billing', false)
                    - if(user.role === 'admin')
                        .admin-nav
                            h5.admin-nav__heading Admin
                            ul.side-nav
                                +userMenuItem('#', 'map', 'Manage Tours', false)
                                +userMenuItem('#', 'users', 'Manage Users', false)
                                +userMenuItem('#', 'star', 'Manage Reviews', false)
                                +userMenuItem('#', 'briefcase', 'Manage Bookings', false)
            //- TODO change this to a reuseable template that has different content in this area - ie settings/bookings
            block subContent
