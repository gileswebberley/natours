extends userAccount
include _reviewCard

block subContent

    .user-view__content
        .user-view__form-container
            h2.heading-secondary.ma-bt-md Your Reviews
            if reviews.length === 0
                h3.heading-secondary You have left no reviews yet
            else
                each review in reviews
                    .card
                        .card__header
                            .card__picture
                                img.card__picture-img(src=`${review.tour.imageCoverUrl}`, alt=`Image for ${review.tour.name}`)
                            h3.heading-tertirary
                                span= review.tour.name
                        .my-reviews__card
                            h4 You commented
                            p.reviews__text= review.review
                            .reviews__rating.ma-bt-md
                                each star in [1, 2, 3, 4, 5]
                                    svg.reviews__star(class=`reviews__star--${+review.rating >= star ? 'active' : 'inactive'}`)
                                        use(xlink:href='/img/icons.svg#icon-star')
                            .card__buttons
                                a.btn.btn--green.btn--small(href=`/edit-review/${review.id}`) Edit Review