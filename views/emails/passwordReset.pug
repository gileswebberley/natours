extends emailBase

block content
    p Hi #{firstName},
    p Forgot your password for the Natours app?
    p No worries, just follow the link below to reset it but please be quick as the link will expire in 10 minutes. This is a security measure to avoid your account being compromised by someone with bad intentions.
    table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
        tbody
            tr
                td(align='left')
                    table(role='presentation', border='0', cellpadding='0', cellspacing='0')
                        tbody
                            tr
                                td
                                    a(href=`${url}`, target='_blank') Reset Password
    p Please keep your login details private, we're here to keep you safe.